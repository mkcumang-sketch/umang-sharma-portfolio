# LLM — any OpenAI-compatible chat-completions endpoint (Ollama, LiteLLM, etc.)
# For a local Ollama server: http://127.0.0.1:11434/v1
# For Vercel, use a reachable HTTPS LiteLLM/Ollama gateway; localhost refers to the Vercel container.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gemma4:12b

# Sarvam Voice Agents — outbound call configuration
# Values are server-only. Never prefix these with NEXT_PUBLIC_.
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=\n# Legacy environment name accepted as a fallback: SARVAM_AGENT_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=

# Comma-separated E.164 numbers allowed to receive test calls.
# Required to prevent public visitors from triggering arbitrary billable calls.
SARVAM_ALLOWED_TEST_NUMBERS=
